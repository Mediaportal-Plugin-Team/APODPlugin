  <allowoverlay>yes</allowoverlay>
  <controls>
    <control>
      <description>image</description>
      <type>image</type>
      <id>3</id>
      <posX>0</posX>
      <posY>0</posY>
      <width>1920</width>
      <height>1080</height>
      <texture>black.jpg</texture>
