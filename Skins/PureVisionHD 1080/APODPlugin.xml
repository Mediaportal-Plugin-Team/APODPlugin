      <posY>0</posY>
      <onup>2</onup>
      <ondown>2</ondown>
    </control>
    <control>
      <description>title</description>
      <type>textbox</type>
      <id>6</id>
      <posX>0</posX>
      <posY>10</posY>
      <width>1920</width>
      <height>45</height>
      <font>Menutitle</font>
